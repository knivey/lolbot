{% extends 'base.twig' %}
{% block content %}
<div class="table-card mb-3">
  <div class="table-card-header">
    <h2>Networks</h2>
    <a class="btn btn-primary" href="/networks/new">+ add network</a>
  </div>
  <table class="table table-sm align-middle">
    <thead>
      <tr><th>id</th><th>name</th><th>servers</th><th>bots</th><th></th></tr>
    </thead>
    <tbody>
      {% for n in networks %}
      <tr><td>{{ n.id }}</td><td>{{ n.name }}{% if n.disabled %} <span class="badge text-bg-danger">disabled</span>{% endif %}</td><td>{{ n.servers|length }}</td><td>{{ n.bots|length }}</td>
        <td><a class="btn btn-outline-secondary btn-sm" href="/networks/{{ n.id }}">edit</a></td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
