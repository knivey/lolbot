{% extends 'base.twig' %}
{% import '_macros.twig' as m %}
{% block content %}
<div class="table-card mb-3">
  <div class="table-card-header">
    <h2>Bots</h2>
    <a class="btn btn-primary" href="/bots/new">+ add bot</a>
  </div>
  <table class="table table-sm align-middle">
    <thead>
      <tr><th>id</th><th>name</th><th>network</th><th>trigger</th><th>channels</th><th></th></tr>
    </thead>
    <tbody>
      {% for b in bots %}
      <tr>
        <td>{{ b.id }}</td><td>{{ b.name }}{% if b.isDisabled %} <span class="badge text-bg-danger">{{ b.disabled ? 'disabled' : 'disabled (network)' }}</span>{% endif %}</td><td>{{ b.network.name }}</td>
        <td>{{ b.trigger ?: (b.trigger_re ?: '') }}</td><td>{{ b.channels|length }}</td>
        <td><a class="btn btn-outline-secondary btn-sm" href="/bots/{{ b.id }}">edit</a></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
